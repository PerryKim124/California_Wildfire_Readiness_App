# Copy this file to .env.local and fill in real values. Never commit real keys.

# Supabase Dashboard → Project Settings → API. The anon key is meant for the browser.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# NASA FIRMS MAP_KEY (https://firms.modaps.eosdis.nasa.gov/usfs/api/map_key/).
# Server-only: read by the /api/firms/california route in vite.config.ts.
# Do NOT add a VITE_ prefix, which would expose it to the browser.
FIRMS_MAP_KEY=
